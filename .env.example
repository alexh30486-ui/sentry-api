# Copy this file to .env and adjust values before running `docker compose up`.
# Never commit the real .env file.

APP_NAME="API Security Scanner"
ENVIRONMENT=development

# These are also hardcoded as defaults in docker-compose.yml's backend
# service, but keeping them here too makes local (non-Docker) runs work.
DATABASE_URL=postgresql+asyncpg://scanner:scanner@localhost:5433/scanner_db
SYNC_DATABASE_URL=postgresql+psycopg2://scanner:scanner@localhost:5433/scanner_db

# Generate a real secret with: openssl rand -hex 32
JWT_SECRET_KEY=change-me-in-production-please
ACCESS_TOKEN_EXPIRE_MINUTES=1440

CORS_ORIGINS=["http://localhost:8080","http://localhost:5173"]

# Hosts the scanner is allowed to point at. Add any host you own/control
# here before scanning it. This exists to keep the tool from being pointed
# at third-party infrastructure without authorization.
ALLOWED_SCAN_HOSTS=["localhost","127.0.0.1","host.docker.internal"]
ENFORCE_HOST_ALLOWLIST=true

MAX_CONCURRENT_REQUESTS_PER_SCAN=10
SCAN_REQUEST_TIMEOUT_SECONDS=10
